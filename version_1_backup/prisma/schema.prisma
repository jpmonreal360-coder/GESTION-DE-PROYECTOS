// Prisma Schema - Gestión Multiproyecto Estilo Apple / Notion
datasource db {
  provider = "sqlite" // O "postgresql" para producción en Supabase/Neon
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Workspace {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  logo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects    Project[]
  users       User[]
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  avatar      String?
  role        String    @default("MEMBER") // ADMIN, MEMBER, VIEWER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  tasks       Task[]     @relation("AssignedTasks")
  expenses    Expense[]
}

model Project {
  id            String    @id @default(uuid())
  name          String
  code          String    // e.g. "APPL-01"
  description   String?
  icon          String?   @default("folder")
  color         String?   @default("#007AFF") // Apple Accent
  status        String    @default("ACTIVE") // ACTIVE, ON_HOLD, COMPLETED, ARCHIVED
  totalBudget   Float     @default(0.0)
  currency      String    @default("USD")
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  categories    BudgetCategory[]
  expenses      Expense[]
  tasks         Task[]
  documents     Document[]
  activities    ActivityLog[]
}

model BudgetCategory {
  id          String    @id @default(uuid())
  name        String    
  allocated   Float     @default(0.0)
  color       String?   @default("#34C759")

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses    Expense[]
}

model Expense {
  id            String    @id @default(uuid())
  type          String    @default("EXPENSE") // "INCOME" (Entrada/Ingreso) | "EXPENSE" (Salida/Gasto)
  concept       String
  amount        Float
  currency      String    @default("USD")
  date          DateTime  @default(now())
  status        String    @default("PAID") // PAID, PENDING, REJECTED
  receiptUrl    String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryId    String?
  category      BudgetCategory? @relation(fields: [categoryId], references: [id])

  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, IN_REVIEW, COMPLETED
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId  String?
  assignee    User?     @relation("AssignedTasks", fields: [assigneeId], references: [id])

  tags        TaskTag[]
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String    @default("#8E8E93")
  tasks     TaskTag[]
}

model TaskTag {
  taskId    String
  tagId     String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Document {
  id          String     @id @default(uuid())
  title       String
  docType     String     @default("PDF") // "PDF", "IMAGE", "GOOGLE_SHEETS", "CONTRACT", "PROPOSAL", "SPEC", "MINUTES", "GUIDE"
  fileUrl     String?    // Link a archivo PDF, Imagen (base64/data URL) o enlace a Google Sheets
  fileType    String?    // "pdf" | "image" | "sheets" | "link"
  previewUrl  String?    // URL de miniatura para fotos/imágenes
  icon        String?    @default("file-text")
  content     String?    // Contenido en texto/markdown o descripción
  isArchived  Boolean    @default(false)
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parentId    String?
  parent      Document?  @relation("DocHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Document[] @relation("DocHierarchy")

  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  action      String   // e.g. "TASK_CREATED", "INCOME_ADDED", "EXPENSE_ADDED", "DOC_UPDATED"
  description String
  createdAt   DateTime @default(now())

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
