# Entorno de Producción Vercel & Base de Datos Persistente (Upstash Redis / Vercel KV REST)

# URL de la API REST de Upstash Redis / Vercel KV
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
KV_REST_API_URL=https://your-upstash-instance.upstash.io

# Token de autenticación Bearer REST
UPSTASH_REDIS_REST_TOKEN=your_upstash_bearer_token_here
KV_REST_API_TOKEN=your_upstash_bearer_token_here

# Base de datos relacional opcional (Prisma / Supabase / Neon)
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
